# Puerto del servidor HTTP
PORT=3000

# PIN inicial de acceso al Panel de Barberos (/admin.html)
# También se puede cambiar desde Configuración dentro del panel
ADMIN_PIN=2026

# Secreto para firmar sesiones de administrador (cambiar en producción)
SESSION_SECRET=dual-barber-cambiar-en-produccion

# Opcional: Integración automática con Google Places API (New) para sincronizar reseñas reales
# Obtener en Google Cloud Console -> Places API (New)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
